# Copy to .env on the VPS. Never commit a filled .env.

# Public hostname (A record → this VPS)
JELLYFIN_DOMAIN=media.example.com

# Folder of files you are allowed to host (read-only in the container)
MEDIA_DIR=/data/media

# Match the Ubuntu user that owns MEDIA_DIR (`id -u` / `id -g`)
PUID=1000
PGID=1000

TZ=America/Chicago
