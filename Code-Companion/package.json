{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.includes('pnpm')){console.error('Use pnpm instead');process.exit(1)}\"",
    "build": "pnpm run typecheck && pnpm --filter @workspace/blkspace run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "pnpm run typecheck",
    "test": "pnpm --filter @workspace/blkspace run test:run",
    "format": "prettier --write \"artifacts/**/*.{ts,tsx,js,json}\" \"lib/**/*.{ts,tsx,js,json}\" \"scripts/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"artifacts/blkspace/src/**/*.{ts,tsx}\" \"artifacts/blkspace/*.{ts,json}\""
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.1",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
