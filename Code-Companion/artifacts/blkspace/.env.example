# Copy to .env in this folder. Do not commit .env.
# Server-side only. Do not place these credentials in a native client.
# The Tauri app uses the hosted NIP-98 API and never receives this token.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Optional native hosted-sync endpoint (HTTPS origin only).
BLKSPACE_API_URL=https://bkspc.app
# BLKSPACE_CLOUD_SYNC=0

# Cloudflare → R2 → Manage R2 API tokens (object read and write).
# R2_PUBLIC_BASE_URL is the bucket's public r2.dev or custom domain.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blkspace-media
R2_PUBLIC_BASE_URL=https://pub-your-id.r2.dev

# Cloudflare → My Profile → API tokens → Stream edit on this account.
CLOUDFLARE_API_TOKEN=
