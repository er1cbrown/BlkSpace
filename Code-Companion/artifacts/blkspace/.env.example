# Copy to .env in this folder. Do not commit .env.
# Turso dashboard → your database → Connect.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Cloudflare → R2 → Manage R2 API tokens (object read and write).
# R2_PUBLIC_BASE_URL is the bucket's public r2.dev or custom domain.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blkspace-media
R2_PUBLIC_BASE_URL=https://pub-your-id.r2.dev

# Cloudflare → My Profile → API tokens → Stream edit on this account.
CLOUDFLARE_API_TOKEN=
