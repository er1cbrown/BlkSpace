          },
          {
            "name": "unstakeDelay",
            "docs": ["Unstake cooldown, seconds."],
            "type": "i64"
          },
          {
            "name": "govDelay",
            "docs": [
              "Proposal timelock, seconds. Never below `MIN_GOV_DELAY`."
