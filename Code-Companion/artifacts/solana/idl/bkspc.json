            "name": "mint",
            "docs": ["Token-2022 mint whose authority this program holds."],
            "type": "publicKey"
          },
          {
            "name": "minter",
            "docs": [
              "Backend signer permitted to mint via `convert_wb_to_bkspc`."
            ],
