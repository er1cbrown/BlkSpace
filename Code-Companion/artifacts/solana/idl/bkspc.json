    {
      "name": "initializeConvert",
      "docs": [
        "One-time Token-2022 setup. Moves mint authority to the program PDA and pins the",
        "`minter` allowed to sign `convert_wb_to_bkspc`, plus the hard supply `cap`.",
        "",
        "A `cap` of 0 is rejected: it would brick settlement, and because governance may",
        "only lower the cap there would be no way to recover."
      ],
      "accounts": [
        {
          "name": "payer",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "convertConfig",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "mint",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "currentMintAuthority",
          "isMut": false,
          "isSigner": true,
          "docs": [
            "Current Token-2022 mint authority (deployer before handoff)."
          ]
        },
        {
          "name": "mintAuthority",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "tokenProgram",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "minter",
          "type": "publicKey"
        },
        {
          "name": "admin",
          "type": "publicKey"
        },
        {
          "name": "cap",
          "type": "u64"
        },
        {
          "name": "unstakeDelay",
          "type": "i64"
        },
        {
          "name": "govDelay",
          "type": "i64"
        }
      ]
    },
    {
      "name": "convertWbToBkspc",
      "docs": [
        "Mint fee-adjusted BKSPC for a recipient who cleared the off-chain WeixBucks gates.",
        "",
        "Both `minter` (proves eligibility) and `user` (the recipient) must sign, and total",
        "supply is checked against the hard `cap`."
      ],
      "accounts": [
        {
          "name": "minter",
          "isMut": false,
          "isSigner": true,
          "docs": ["Backend signer. Must equal `convert_config.minter`."]
        },
        {
          "name": "user",
          "isMut": false,
          "isSigner": true,
          "docs": [
            "Recipient. Must sign so the mint cannot be redirected to a third party."
          ]
        },
        {
          "name": "convertConfig",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "mint",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "userAta",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "mintAuthority",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "tokenProgram",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "amountBkspc",
          "type": "u64"
        }
      ]
    },
    {
      "name": "rotateMinter",
      "docs": [
